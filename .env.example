# Порт API и ботов
PORT=8787
# PostgreSQL без Docker: локально — Homebrew или docker compose --profile local-db up -d db
DATABASE_URL=postgres://localhost:5432/ochakovo

# ── Docker (docker-compose.yml, подробно — docs/deploy.md) ──
# Адрес управляемой базы провайдера. С ним контейнер базы не нужен: docker compose up -d --build
APP_DATABASE_URL=
# База в контейнере рядом с сервером: docker compose --profile local-db up -d --build. Пароль обязателен,
# значения по умолчанию нет. Без @ : / и пробелов — он попадает в адрес базы. С APP_DATABASE_URL не нужен
POSTGRES_PASSWORD=
POSTGRES_USER=ochakovo
POSTGRES_DB=ochakovo
# Порты на этой машине (только 127.0.0.1): сервер и база из профиля local-db
APP_PORT=8787
POSTGRES_PORT=5432
# Первый администратор HR-панели (пароль от 10 символов). Без них в разработке создаётся демо-вход
HR_ADMIN_EMAIL=
HR_ADMIN_PASSWORD=
# Устаревший служебный токен: только чтение заявок скриптами (x-hr-token), от 16 символов. Пусто — выключен
HR_TOKEN=
# Демо-данные и «Очистить базу» в HR-панели. В рабочей версии (NODE_ENV=production) их нет; 1 — включить для демо-стенда
HR_DEMO_TOOLS=
# Внешний канал диалога: POST /api/dialog с каналом telegram/max только с этим токеном (заголовок x-dialog-token), от 24 символов.
# Боты Telegram и MAX работают внутри сервера, чату на сайте токен не нужен. Пусто — снаружи только чат сайта
DIALOG_API_TOKEN=
# Через сколько секунд уходит сообщение кандидату после действия HR (пока можно отменить)
HR_NOTIFY_DELAY_SECONDS=20
# Выгрузка заявок на Яндекс Диск компании (Яндекс 360 для бизнеса). Подробно — docs/hr.md
YANDEX_DISK_TOKEN=
YANDEX_DISK_REFRESH_TOKEN=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_DISK_ROOT=disk:/Очаково HR
YANDEX_DISK_SYNC_MINUTES=60
# SMS кандидатам без бота: приглашение и напоминание. Пусто — выключено. Подробно — docs/hr.md
SMS_PROVIDER=
SMS_API_KEY=
SMS_LOGIN=
SMS_PASSWORD=
SMS_SENDER=
# Срок хранения личных данных в заявках, месяцев после последнего изменения статуса (политика обработки данных — 12)
RETENTION_MONTHS=12
# hh.ru: публикация вакансий только по кнопке из панели. Подробно — docs/hr.md
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_ACCESS_TOKEN=
HH_REFRESH_TOKEN=
HH_EMPLOYER_ID=
HH_USER_AGENT=OchakovoHR/1.0 (rabota@ochakovo.ru)
HH_ADDRESS_ID=
# Регион вакансии на hh.ru (1 — Москва) и вариант публикации (пусто — HH_STANDARD)
HH_AREA_ID=1
HH_VACANCY_PROPERTY=
# Боты: без токена адаптер не запускается
TELEGRAM_BOT_TOKEN=
# Имя бота без @ — для кнопок бота на сайте (GET /api/config) и ссылок «Позвать друга» (t.me/<имя>?start=ref_<код>).
# Сайт показывает кнопку, только когда адаптер поднялся и имя задано
TELEGRAM_BOT_USERNAME=
MAX_BOT_TOKEN=
# Ник бота в MAX — для кнопок бота на сайте и ссылок «Позвать друга» (max.ru/<ник>?start=ref_<код>)
MAX_BOT_NICK=
# Секреты вебхуков (латиница, цифры, _ и -, от 32 знаков): мессенджер присылает их в заголовке, сервер сверяет.
# Пусто при заданном PUBLIC_URL — сервер сам создаёт секрет при каждом запуске и передаёт его мессенджеру.
# Если серверов несколько, задайте секрет явно: иначе у каждого будет свой
TELEGRAM_WEBHOOK_SECRET=
MAX_WEBHOOK_SECRET=
# Публичный HTTPS-адрес сервера для вебхуков; пусто — боты сами опрашивают мессенджер, маршруты /bots/* закрыты
PUBLIC_URL=
# Адрес сайта: ссылки из бота, превью ссылок, карта сайта, разрешённый источник запросов.
# В рабочей версии (NODE_ENV=production) обязателен и начинается с https:// — иначе сервер не стартует
SITE_URL=http://localhost:5180
# Сколько прокси перед сервером (nginx, балансировщик) — обычно 1. Пусто — сервер смотрит в интернет сам
TRUST_PROXY=
# GigaChat для помощника «Спросить Квасыча». Без ключа помощник работает в офлайн-режиме по базе знаний.
# Ключ авторизации — в GigaChat Studio (developers.sber.ru). Сертификат Минцифры: sh scripts/max-cert.sh и NODE_EXTRA_CA_CERTS
GIGACHAT_AUTH_KEY=
# GIGACHAT_API_PERS — физлица, GIGACHAT_API_B2B или GIGACHAT_API_CORP — компания
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL_FAST=GigaChat-2
GIGACHAT_MODEL_ANSWER=GigaChat-2-Pro
# Адрес API GigaChat. Пусто — https://api.giga.chat/v1; свой — для договора компании или прокси
GIGACHAT_BASE_URL=
# Сколько запросов к GigaChat одновременно. Физлицам разрешён один; по договору компании — сколько в нём указано.
# Остальные запросы ждут своей очереди
GIGACHAT_CONCURRENCY=1
# Сколько вопросов может ждать очереди к GigaChat. Больше — Квасыч сразу отвечает офлайн по базе знаний. Пусто — 8
GIGACHAT_QUEUE=

# ── Аналитика (подробно — docs/deploy.md) ──
# Счётчики включаются только с ID: сервер ставит в страницу метатег, CSP разрешает их домены, сайт спрашивает согласие
# в плашке и только после него загружает счётчики. Пусто — ни плашки, ни одного запроса к ним. Пересборка не нужна
METRIKA_ID=
# Пиксель VK Рекламы: номер из кабинета ads.vk.com
VK_PIXEL_ID=
# Ещё адреса, с которых можно отправлять формы (через запятую, с https://), кроме SITE_URL и PUBLIC_URL
ALLOWED_ORIGINS=
# Имя первого администратора в панели (по умолчанию «Администратор»)
HR_ADMIN_NAME=
