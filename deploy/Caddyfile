# HTTPS для стенда: Caddy сам получает сертификат Let's Encrypt для DOMAIN из .env и продлевает его.
# Запускается сервисом caddy из docker-compose.yml (профиль https), сайт слушает 127.0.0.1:8787 на этой же машине.

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	reverse_proxy 127.0.0.1:8787
}
